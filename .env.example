# --- GitHub App (see README, "Create the GitHub App") ---
GITHUB_APP_ID=5464057
# Path to the private key you downloaded from the App settings page (keep it out of git)
GITHUB_PRIVATE_KEY_PATH=./patchforge-app.private-key.pem
# The webhook secret you typed when creating the App
GITHUB_WEBHOOK_SECRET=change-me
# "Sign in with GitHub": Client ID and a generated client secret, from the same App's settings page
GITHUB_CLIENT_ID=Iv23liJ7E541asWq5Aj4
GITHUB_CLIENT_SECRET=bffb7b4ef43b1bcc30214e0290fed343c79050b9
# The address users open; must match the App's Callback URL ({this}/auth/callback)
PATCHFORGE_PUBLIC_URL=http://127.0.0.1:8000

# --- Agent ---
# brain (the real agent: Tavily + Nebius Token Factory) | stub (fake, no API keys needed)
PATCHFORGE_AGENT=brain
NEBIUS_API_KEY=v1.CmMKHHN0YXRpY2tleS1lMDBtcDlzcjh5MDh4Nnk0ejASIXNlcnZpY2VhY2NvdW50LWUwMHN3NGpkejJ3a205MThxNDILCNHqh9YGEJ_8hRk6DAjP7Z-hBxDArObXAkACWgNlMDA.AAAAAAAAAAEynHxiT71t4YamrA11XJ7m-ra1NT_lgjOeCWqnOvfw0KXGTM-EE99d_uLXlRTsGZJF6ZEFuw5Xw4UBn4XnpQUD
TAVILY_API_KEY=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
# Research model (Qwen3-235B) and code model (Kimi-K2.7-Code) by default; see brain.py. Leave empty for the defaults.
PATCHFORGE_ARCHITECT_MODEL=
PATCHFORGE_WORKER_MODEL=
# Fixes code after a failed check (default: the code model)
PATCHFORGE_FIXER_MODEL=
# Seconds before a slow code-model call is retried on the research model
PATCHFORGE_MODEL_TIMEOUT=120
# Files patched in parallel
PATCHFORGE_WORKERS=4
# Where successful migrations are saved and reused
PATCHFORGE_SKILLS_DIR=skills

# --- Sandbox ---
# docker (real isolation) | nebius (Serverless AI Jobs, falls back to Docker) | local (no isolation, your own code only) | fake
PATCHFORGE_SANDBOX=docker
SANDBOX_IMAGE=python:3.12-slim
# Where sandbox copies are made; must be a folder Docker can mount (default ~/.cache/patchforge/sandbox)
PATCHFORGE_SANDBOX_TMP=
# Required for PATCHFORGE_SANDBOX=nebius: a CPU platform and preset from your Nebius project
NEBIUS_JOB_PLATFORM=
NEBIUS_JOB_PRESET=
# Interpreter for PATCHFORGE_SANDBOX=local (old libraries often need an older Python, e.g. python3.12)
PATCHFORGE_LOCAL_PYTHON=

# --- Platform ---
# Job history (survives restarts)
PATCHFORGE_DATA_DIR=.patchforge-data
# Optional key for scripts (scripts/watch_job.py). Acts across all installations: keep it secret.
PATCHFORGE_API_KEY=
# Dashboard origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
