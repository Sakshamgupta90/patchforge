# --- GitHub App (see README, "Create the GitHub App") ---
GITHUB_APP_ID=123456
# Path to the private key you downloaded from the App settings page (keep it out of git)
GITHUB_PRIVATE_KEY_PATH=./patchforge-app.private-key.pem
# The webhook secret you typed when creating the App
GITHUB_WEBHOOK_SECRET=change-me

# --- Platform ---
# docker (real isolation) | local (runs tests on this machine, trusted code only) | fake (canned results)
PATCHFORGE_SANDBOX=docker
SANDBOX_IMAGE=python:3.12-slim
# stub (fake agent until Person A's agent lands)
PATCHFORGE_AGENT=stub
# If set, POST /jobs requires "Authorization: Bearer <key>"
PATCHFORGE_API_KEY=
# Dashboard origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
